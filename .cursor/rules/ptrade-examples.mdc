## 示例三：定时任务策略

```python
def initialize(context):
    set_benchmark("000300.SS")
    g.security = '600519.SS'
    set_universe([g.security])

    run_daily(context, morning_check, '09:31')
    run_daily(context, afternoon_close, '14:50')


def morning_check(context):
    snapshot = get_snapshot(g.security)
    open_price = snapshot[g.security]['open_px']
    log.info(f"开盘价: {open_price}")

    hist = get_history(5, '1d', 'close', [g.security], include=False)
    avg_5 = hist[g.security].mean()

    if open_price > avg_5:
        position = context.portfolio.positions.get(g.security)
        if not position or position.amount == 0:
            order_value(g.security, context.portfolio.cash * 0.8)
            log.info("开盘价高于5日均线，买入")


def afternoon_close(context):
    position = context.portfolio.positions.get(g.security)
    if position and position.amount > 0:
        profit_rate = (position.last_sale_price - position.cost_basis) / position.cost_basis
        if profit_rate > 0.03 or profit_rate < -0.02:
            order_target(g.security, 0)
            log.info(f"止盈止损平仓，收益率: {profit_rate:.2%}")


def handle_data(context, data):
    pass
```

