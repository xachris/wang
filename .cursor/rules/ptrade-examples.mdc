## 示例二：MACD 策略

```python
def initialize(context):
    set_benchmark("000300.SS")
    set_commission(commission_ratio=0.0003, min_commission=5.0, type="STOCK")

    g.security_list = ["600519.SS"]
    set_universe(g.security_list)
    log.info("MACD策略初始化完成")


def get_MACD(close_data, short=12, long=26, mid=9):
    """计算MACD指标"""
    import numpy as np
    short_ema = close_data.ewm(span=short, adjust=False).mean()
    long_ema = close_data.ewm(span=long, adjust=False).mean()
    DIF = short_ema - long_ema
    DEA = DIF.ewm(span=mid, adjust=False).mean()
    MACD = 2 * (DIF - DEA)
    return DIF, DEA, MACD


def handle_data(context, data):
    for security in g.security_list:
        hist = get_history(60, frequency="1d", field="close",
                          security_list=[security], fq='pre')
        import pandas as pd
        close_data = pd.Series(hist[security].values.flatten())

        DIF, DEA, MACD = get_MACD(close_data)

        dif_now = DIF.iloc[-1]
        dea_now = DEA.iloc[-1]
        macd_now = MACD.iloc[-1]
        macd_prev = MACD.iloc[-2]

        position = context.portfolio.positions.get(security)
        current_amount = position.amount if position else 0

        if current_amount == 0:
            if dif_now > 0 and dea_now > 0 and macd_prev < 0 and macd_now >= 0:
                order_target_value(security, context.portfolio.cash * 0.9)
                log.info(f"MACD金叉，买入 {security}")
        else:
            if dif_now < 0 and dea_now < 0 and macd_prev >= 0 and macd_now < 0:
                order_target(security, 0)
                log.info(f"MACD死叉，卖出 {security}")
```

