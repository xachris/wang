# PTRADE 策略示例代码

## 示例一：双均线策略（入门模板）

```python
def initialize(context):
    set_benchmark("000300.SS")
    set_commission(commission_ratio=0.0003, min_commission=5.0, type="STOCK")
    set_slippage(slippage=0.0024)

    g.security_list = ["600519.SS", "000001.SZ"]
    set_universe(g.security_list)

    g.short_ma_period = 10
    g.long_ma_period = 30
    g.traded_today = False

    log.info("策略初始化完成。")


def before_trading_start(context, data):
    g.traded_today = False
    g.today_options = list(g.security_list)

    hist = get_history(1, frequency="1d", field="close",
                       security_list=g.security_list, fq=None, include=False)
    log.info(f"今日备选股票池: {g.today_options}")


def handle_data(context, data):
    for security in g.security_list:
        hist = get_history(g.long_ma_period + 5, frequency="1d",
                          field="close", security_list=[security])
        close_prices = hist[security]

        short_ma = close_prices[-g.short_ma_period:].mean()
        long_ma = close_prices[-g.long_ma_period:].mean()

        prev_short = close_prices[-(g.short_ma_period+1):-1].mean()
        prev_long = close_prices[-(g.long_ma_period+1):-1].mean()

        position = context.portfolio.positions.get(security)
        current_amount = position.amount if position else 0

        if current_amount == 0:
            if short_ma > long_ma and prev_short <= prev_long:
                if context.portfolio.cash > 10000:
                    order_target_value(security, context.portfolio.cash * 0.45)
                    log.info(f"金叉买入 {security}")
        else:
            if short_ma < long_ma and prev_short >= prev_long:
                order_target(security, 0)
                log.info(f"死叉卖出 {security}")


def after_trading_end(context, data):
    for security, pos in context.portfolio.positions.items():
        if pos.amount > 0:
            pnl = (pos.last_sale_price - pos.cost_basis) * pos.amount
            log.info(f"持仓 {security}: {pos.amount}股, 盈亏={pnl:.2f}")
    log.info(f"当日总资产: {context.portfolio.portfolio_value:.2f}")
```

